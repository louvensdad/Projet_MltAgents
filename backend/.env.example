# Variáveis de ambiente do Control Panel

# --- PAGAMENTO ---
# Provedor ativo: "mock" para testes, "stripe" ou "mercadopago" em produção
PAYMENT_PROVIDER=mock

# Stripe (preencha em produção)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (preencha em produção)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- BACKEND ---
BACKEND_PORT=8001
FRONTEND_URL=http://localhost:4321

# ==========================================
# GEMINI AI BOOST (ADD-ON PAGO)
# ==========================================
# Chave da API Gemini (obtenha em https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# Habilitar AI Boost globalmente (true/false)
AI_BOOST_ENABLED=false

# Limite padrão de requests por projeto (quando não há plano ativo)
AI_BOOST_MAX_REQUESTS=50
