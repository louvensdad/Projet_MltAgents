# ── AI / Gemini ───────────────────────────────────────────────
# Habilitar Gemini real (true) ou desligado (false)
GEMINI_ENABLED=true

# Chave da API Gemini (obtenha em https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo Gemini (padrão: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Se Gemini falhar, permitir fallback para modo Mock?
# false = bloqueia geracao sem Gemini real
ALLOW_MOCK_AI=false

# ── AI Generation Mode ──────────────────────────────────────
# Modo padrao de geracao de IA: premium | economy | mock
# premium: Gemini real para tudo (max 8 calls, 8000 tokens)
# economy: Gemini so para decisoes importantes (max 2 calls, 3000 tokens)
# mock: sem chamadas Gemini, apenas templates locais
AI_GENERATION_MODE_DEFAULT=economy

# Numero maximo de chamadas AI permitidas por projeto
AI_MAX_CALLS_PER_PROJECT=10

# Custo maximo estimado por geracao: low | medium | high
AI_MAX_COST_PER_GENERATION=medium

# ── Provedor alternativo (OpenAI/LM-Studio) ──────────────────
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_BASE=
OPENAI_API_KEY=your_openai_api_key_here

# ── Banco de Dados ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=saas_factory
DATABASE_URL=postgresql://postgres:postgres@db:9876/saas_factory

# ── Segurança ────────────────────────────────────────────────
JWT_SECRET=super-secret-key-change-it
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# LDCN / Vens Jarvis Voice
# browser = usa o speechSynthesis como fallback local
# elevenlabs = tenta audio premium pelo backend e cai para browser se falhar
LDCN_VOICE_PROVIDER=elevenlabs
LDCN_VOICE_FALLBACK=browser
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
